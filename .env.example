# Copy this file to .env before running:
#   cp .env.example .env
#
# Nothing here is secret — this project runs entirely on your machine.
# No API keys, no cloud services, no accounts.

# ---- Qdrant (vector database) ----
QDRANT_URL=http://localhost:6333
COLLECTION=papers

QDRANT_BIN=./bin/qdrant
QDRANT_STORAGE=./qdrant-data
QDRANT_STATIC=./static

# Downloaded by `npm run setup` (or automatically on first `npm start`)
QDRANT_VERSION=v1.19.1
QDRANT_UI_VERSION=v0.2.18

# ---- Embedding model ----
# VECTOR_SIZE must match what the model outputs.
# all-MiniLM-L6-v2 -> 384.  If you switch models, change both.
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
VECTOR_SIZE=384

# ---- Chunking ----
# These two matter more than anything else for retrieval quality.
# Change them and re-run ingest to see the difference.
CHUNK_WORDS=200
CHUNK_OVERLAP=50

# ---- Search ----
TOP_K=5
MIN_SCORE=0.3

# ---- Input ----
DOCS_DIR=docs
